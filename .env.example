# Copy to .env on the build server (never commit).
# chmod 600 .env

# --- App source (cloned/updated automatically — no manual chessonchain clone) ---
BUILD_REPO_URL=https://github.com/incryptoencrypted/chessonchain.git
BUILD_REPO_PATH=/var/cache/chessonchain-build/app
BUILD_BRANCH=develop

# --- Docker image (GHCR) ---
BUILD_IMAGE=ghcr.io/incryptoencrypted/chessonchain
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_ACTOR=incryptoencrypted

# --- Build steps (paths relative to BUILD_REPO_PATH) ---
BUILD_ENV_SCRIPT=scripts/ci-build-env.mjs
BUILD_DOCKERFILE=Dockerfile
BUILD_PLATFORM=linux/amd64

# staging → :staging tag | production → :latest tag
BUILD_DEPLOY_TARGET=staging

# --- Coolify redeploy (after image push) ---
COOLIFY_DEPLOY_WEBHOOK=https://coolify.example/api/v1/deploy/...
COOLIFY_TOKEN=

# --- App build secrets (exported for ci-build-env.mjs in the app repo) ---
# Copy from GitHub Environment secrets — names must match your app's script.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
NEXT_PUBLIC_THIRDWEB_REDIRECT_URI=
THIRDWEB_CLIENT_ID=
THIRDWEB_CLIENT_SECRET=
THIRDWEB_REDIRECT_URI=
MONGO_URI=
STACKS_WALLET_SECRET=
POLKADOT_KEY=
EVM_KEY=
CASINO_EVM_KEY=
CASINO_ORACLE_KEY=
ABLY_SERVER_API_KEY=
NEXT_PUBLIC_ABLY_CLIENT_API_KEY=
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_WEBHOOK_SECRET=
REDIS_URL=
SOLANA_KEY=
SOLANA_CASINO_KEY=
ADMIN_ACCOUNTS=
SUPER_ADMIN_USER_IDS=

# Optional
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Webhook listener (auto deploy on push to BUILD_BRANCH) ---
WEBHOOK_SECRET=change-me-to-random-hex
WEBHOOK_PORT=9876
WEBHOOK_PATH=/github
# BUILD_DEPLOY_TARGET=staging
