# =============================================================================
# Copy to /opt/build-server/.env on your build VPS (chmod 600)
# Generate from chessonchain repo:
#   node scripts/export-buildserver-env.mjs
# → .ci-secrets/buildserver.env
# =============================================================================

# --- Global (shared) ---
GITHUB_TOKEN=
GITHUB_ACTOR=incryptoencrypted
BUILD_REPO_URL=https://github.com/incryptoencrypted/chessonchain.git
BUILD_REPO_CACHE_ROOT=/var/cache/chessonchain-build
BUILD_IMAGE=ghcr.io/incryptoencrypted/chessonchain
COOLIFY_TOKEN=

WEBHOOK_SECRET=
WEBHOOK_PORT=9876
WEBHOOK_PATH=/github

# --- Staging (git branch: develop → image :staging) ---
STAGING_BRANCH=develop
STAGING_COOLIFY_DEPLOY_WEBHOOK=https://coolify.chessonchain.online/api/v1/deploy?uuid=yekvuai1mzlot82vhkwoxt92
STAGING_REPO_CACHE=/var/cache/chessonchain-build/staging

STAGING_NEXT_PUBLIC_BASE_URL=https://staging.chessonchain.io
STAGING_MONGO_URI=
# ... all build keys prefixed STAGING_ (see chessonchain scripts/ci-build-env.mjs)

# --- Production (git branch: stable-master-01 → image :latest) ---
PRODUCTION_BRANCH=stable-master-01
PRODUCTION_COOLIFY_DEPLOY_WEBHOOK=https://coolify.chessonchain.online/api/v1/deploy?uuid=ygnoj4r7ist5k113980wylkn
PRODUCTION_REPO_CACHE=/var/cache/chessonchain-build/production

PRODUCTION_NEXT_PUBLIC_BASE_URL=https://play.chessonchain.io
PRODUCTION_MONGO_URI=
# ... all build keys prefixed PRODUCTION_
