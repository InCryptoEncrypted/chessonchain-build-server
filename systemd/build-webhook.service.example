[Unit]
Description=GitHub webhook → Docker build → Coolify deploy
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/build-server
Environment=BUILD_SERVER_ENV=/opt/build-server/.env
ExecStart=/usr/bin/node /opt/build-server/scripts/webhook-listener.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
